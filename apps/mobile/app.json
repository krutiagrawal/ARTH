{
  "expo": {
    "name": "Arth",
    "slug": "arth",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A3A16"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.arth.app",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "instagram",
          "instagram-stories",
          "whatsapp",
          "twitter"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1A3A16"
      },
      "package": "com.arth.app",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-image-picker",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Arth needs your location to record where you plant trees.",
          "locationWhenInUsePermission": "Arth needs your location to record where you plant trees."
        }
      ],
      "expo-secure-store",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.arth.app",
          "enableGooglePay": false
        }
      ],
      "expo-audio",
      "@maplibre/maplibre-react-native",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#2D5A27"
        }
      ],
      [
        "@react-native-community/datetimepicker",
        {
          "android": {
            "datePicker": {
              "colorAccent": {
                "light": "#2D5A27"
              },
              "colorControlActivated": {
                "light": "#2D5A27"
              },
              "colorControlHighlight": {
                "light": "#A8C499"
              },
              "textColorPrimary": {
                "light": "#2D2A25"
              },
              "textColorSecondary": {
                "light": "#4A4034"
              },
              "windowBackground": {
                "light": "#FFF8ED"
              }
            },
            "timePicker": {
              "headerBackground": {
                "light": "#2D5A27"
              },
              "numbersSelectorColor": {
                "light": "#2D5A27"
              },
              "numbersBackgroundColor": {
                "light": "#FFF8ED"
              },
              "numbersTextColor": {
                "light": "#2D2A25"
              }
            }
          }
        }
      ]
    ],
    "extra": {
      "expo-navigation-bar": {
        "enforceContrast": false
      }
    },
    "owner": "kruti_agrawal"
  }
}
