generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  individual
  community
  ngo
  nursery
  organisation
}

enum LeaderboardCategory {
  Individuals
  Communities
  NGOs
  Cities
  Schools
  Companies
  Forests
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String
  name         String
  accountType  AccountType
  place        String?
  isAdmin      Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  plantedTrees          PlantedTree[]
  adoptions             Adoption[]
  rsvps                 Rsvp[]
  pledges               Pledge[]
  passwordResetTokens   PasswordResetToken[]
  competitionEntries    CompetitionEntry[]
  competitionEntryVotes CompetitionEntryVote[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Forest {
  id          String @id
  name        String
  location    String
  trees       Int
  volunteers  Int
  species     Int
  established String
  imageUrl    String
  story       String
}

model LegacyTree {
  id       String @id
  name     String
  species  String
  owner    String
  years    Int
  location String
  imageUrl String
  quote    String

  adoptions Adoption[]
}

model Competition {
  id       String   @id
  title    String
  tagline  String
  deadline DateTime
  entries  Int
  imageUrl String

  submissions CompetitionEntry[]
}

model CompetitionEntry {
  id            String   @id @default(cuid())
  competitionId String
  userId        String
  title         String
  description   String
  imageUrl      String?
  votes         Int      @default(0)
  createdAt     DateTime @default(now())

  competition Competition            @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  voters      CompetitionEntryVote[]
}

model CompetitionEntryVote {
  id        String   @id @default(cuid())
  entryId   String
  userId    String
  createdAt DateTime @default(now())

  entry CompetitionEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([entryId, userId])
}

model Blog {
  id       String @id
  title    String
  category String
  author   String
  date     String
  minutes  Int
  imageUrl String
  excerpt  String
}

model Partner {
  id      Int     @id @default(autoincrement())
  group   String
  name    String
  logoUrl String?
}

model EcosystemEntry {
  id          String @id
  title       String
  description String
  long        String
}

model LeaderboardEntry {
  id       Int                  @id @default(autoincrement())
  category LeaderboardCategory
  name     String
  place    String
  score    Int
}

model Drive {
  id        String   @id
  title     String
  ngo       String
  location  String
  date      DateTime
  spots     Int
  spotsLeft Int

  rsvps Rsvp[]
}

model Stat {
  id     Int    @id @default(autoincrement())
  label  String
  value  Int
  suffix String
}

model TimelineEntry {
  id    Int    @id @default(autoincrement())
  year  String
  title String
  text  String
}

model MapPoint {
  id    Int    @id @default(autoincrement())
  x     Int
  y     Int
  label String
}

model PlantedTree {
  id        String   @id @default(cuid())
  userId    String
  name      String
  species   String
  location  String
  message   String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Adoption {
  id        String   @id @default(cuid())
  userId    String
  treeId    String
  createdAt DateTime @default(now())

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tree LegacyTree @relation(fields: [treeId], references: [id], onDelete: Cascade)

  @@unique([userId, treeId])
}

model Rsvp {
  id        String   @id @default(cuid())
  userId    String
  driveId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  drive Drive @relation(fields: [driveId], references: [id], onDelete: Cascade)

  @@unique([userId, driveId])
}

enum PledgeStatus {
  pending
  paid
  failed
}

model Pledge {
  id                    String       @id @default(cuid())
  userId                String
  ngo                   String
  amount                Int
  message               String?
  status                PledgeStatus @default(pending)
  stripeSessionId       String?      @unique
  stripePaymentIntentId String?
  createdAt             DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}
