DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/Arth?schema=public"
JWT_SECRET="replace-with-a-long-random-string"
API_URL="http://localhost:4000"

# Public site URL — used for metadataBase/sitemap/OG tags and password-reset links.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Resend (https://resend.com) — used for password reset emails. Leave unset in dev;
# lib/email.js logs to the console instead of sending when this is missing.
RESEND_API_KEY=""
EMAIL_FROM="ARTH <hello@arth.example.org>"

# Stripe (https://dashboard.stripe.com/test/apikeys) — test-mode keys are fine.
# Leave unset and /donate falls back to recording a pledge with no real charge
# (same as before this was wired up). Set both to take real payments via Checkout.
# Prefer a restricted key (rk_...) scoped to Checkout Sessions + Webhook Endpoints
# over the full secret key (sk_...) — see https://docs.stripe.com/keys/restricted-api-keys
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
