DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/plant?schema=public"
API_URL="http://localhost:4000"

# Same host as API_URL, but exposed to the browser — uploaded photos (posts,
# logos, tree/drive photos) are stored as paths relative to the API's own
# origin, and the browser needs this to load them directly via <img src>.
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Public site URL — used for metadataBase/sitemap/OG tags.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Resend (https://resend.com) — used for the /contact form and admin notification
# emails. Leave unset in dev; lib/email.js logs to the console instead of sending.
RESEND_API_KEY=""
EMAIL_FROM="ARTH <hello@arth.example.org>"

# Publishable key for the /app member area's plant-sponsorship checkout and the
# /donate campaign flow — both confirm a PaymentIntent created by services/api, so
# this must be the publishable counterpart of *that* Stripe account's secret key
# (services/api's own STRIPE_SECRET_KEY).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
