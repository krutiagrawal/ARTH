# Dependencies
node_modules/

# Build output
dist/
build/
.next/
out/
apps/mobile/.expo/
apps/mobile/web-build/

# Env files (NOTE: files already tracked before this .gitignore existed remain
# tracked until explicitly untracked with `git rm --cached` -- this only stops
# NEW/untracked env files from being committed by accident going forward)
.env
.env.*
!.env.example

# Logs & caches
*.log
npm-debug.log*
.eslintcache
.turbo/

# Uploads (backend-generated content, not source)
services/api/uploads/*
!services/api/uploads/.gitkeep

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Misc
*.pem
.metro-health-check*

# Firebase credentials (google-services.json ships inside the APK anyway, so keeping
# it out of git buys no real secrecy and EAS's archive upload skips untracked files
# matching this field -- it needs to be tracked. The admin SDK key is the actual secret.)
*firebase-adminsdk*.json

# Playwright
apps/web/test-results/
apps/web/playwright-report/
apps/web/playwright/.cache/
