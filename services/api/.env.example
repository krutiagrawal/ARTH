DATABASE_URL="postgresql://postgres:12345@127.0.0.1:5432/Plant?schema=public"
JWT_ACCESS_SECRET=replace-with-a-random-64-char-hex-string
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
PORT=4000
UPLOAD_DIR=./uploads
CORS_ORIGIN=*
OWM_API_KEY=get-a-free-key-at-openweathermap.org/api

# Stripe (https://dashboard.stripe.com/test/apikeys) — test-mode keys are fine.
# Powers campaign donations and drive-plant sponsorships (PaymentIntents).
# Leave unset in dev and those endpoints respond 503 instead of erroring.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
