DATABASE_URL="postgresql://postgres:12345@127.0.0.1:5432/Plant?schema=public"
JWT_ACCESS_SECRET=replace-with-a-random-64-char-hex-string
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
PORT=4000
UPLOAD_DIR=./uploads
CORS_ORIGIN=*
OWM_API_KEY=get-a-free-key-at-openweathermap.org/api

# Stripe (https://dashboard.stripe.com/test/apikeys) — test-mode keys are fine.
# Powers campaign donations and drive-plant sponsorships (PaymentIntents).
# Leave unset in dev and those endpoints respond 503 instead of erroring.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Resend (https://resend.com) — used for password reset emails. Leave unset in dev;
# email.service.ts logs to the console instead of sending when this is missing.
RESEND_API_KEY=""
EMAIL_FROM="PLANT <hello@plant.example.org>"

# Base URL of apps/web — used to build the link in password-reset emails.
WEB_URL="http://localhost:3000"

# Gemini (https://aistudio.google.com/apikey) — used to AI-verify that a submitted photo
# actually shows a tree being planted before the planting is allowed to save. Leave unset in
# dev and the check is skipped (photos pass through unverified) instead of blocking planting.
GEMINI_API_KEY=""
